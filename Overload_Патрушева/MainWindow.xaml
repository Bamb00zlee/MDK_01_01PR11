<Window x:Class="Overload_Патрушева.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Overload_Патрушева"
        mc:Ignorable="d"
        Title="Students" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="59*"/>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="51*"/>
            <RowDefinition Height="41*"/>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="132*"/>
            <RowDefinition Height="56*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="309*"/>
            <ColumnDefinition Width="310*"/>
            <ColumnDefinition Width="181*"/>
        </Grid.ColumnDefinitions>
        <TextBox
            x:Name="forFIO" 
            Margin="10,10,10,10" Grid.ColumnSpan="2"/>
        <Button
            Content="ДОБАВИТЬ"
            Foreground="White"
            FontWeight="Bold"
            Background="Black" 
            Margin="10,10,10,10" 
            Grid.Column="2"
            Click="Add_students"/>
        <ListBox
            x:Name="forListStudent" 
            Margin="10,10,10,10" 
            Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="5"/>
        <Button
            Content="Очистить список"
            Foreground="White"
            FontWeight="Bold"
            Background="Black" 
            Margin="10,10,10,10" 
            Grid.Row="6"
            Click="Clear_list"/>
        <Button
            Content="Вывести список"
            Foreground="White"
            FontWeight="Bold"
            Background="Black" 
            Margin="10,10,10,10" 
            Grid.Column="1" Grid.Row="6"
            Click="Get_list"/>
        <TextBox
            x:Name="forRazdelitel" 
            Grid.Column="2" 
            Margin="10,10,10,10" 
            Grid.Row="1"/>
        <ComboBox 
            Margin="10,10,10,10" 
            Grid.Row="2" 
            Grid.Column="2">
            <ComboBoxItem Content=","/>
            <ComboBoxItem Content=";"/>
            <ComboBoxItem Content="|"/>
            <ComboBoxItem Content="—"/>
            <ComboBoxItem Content="пробел"/>
            <ComboBoxItem Content="перенос строки"/>
        </ComboBox>


        <CheckBox 
            Margin="10,10,10,10" 
            Grid.Row="3" 
            Grid.Column="2"
            Content="Сортировка по ФИО"
            Name="FIOSort"/>
        <CheckBox
            Margin="10,10,10,10" 
            Grid.Row="4" 
            Grid.Column="2"
            Content="Обратный порядок"
            Name="Revers"/>





    </Grid>
</Window>
